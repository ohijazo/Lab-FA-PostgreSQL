SECRET_KEY=canvia-per-una-clau-segura-aleatoria
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=canvia-password
CORS_ORIGINS=http://localhost:5173
POWER_AUTOMATE_WEBHOOK_URL=

# Adjunts (imatges i videos). A produccio, fora de /var/www perque ni el
# git pull ni el canvi de dist el toquin: UPLOAD_FOLDER=/var/lib/lab-fa/adjunts
UPLOAD_FOLDER=
